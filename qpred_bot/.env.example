# ============ Telegram 配置 ============
# 从 @BotFather 获取
BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 管理员 Telegram User ID (多个用逗号分隔)
# 获取方式: 给 @userinfobot 发消息
ADMIN_IDS=123456789,987654321

# 群组 ID (可选, 用于定向广播 / 定时播报)
GROUP_CHAT_ID=-1001234567890

# ============ AI 配置 (支持多模型供应商) ============
# 模型供应商: openai | deepseek | anthropic | openrouter | custom
AI_PROVIDER=openai

# 通用 API Key (按所选 PROVIDER 填入对应 Key)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 自定义 BASE_URL (留空则使用各供应商默认地址)
# 例如: https://api.deepseek.com/v1 / https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# 主推理模型 (建议使用最强推理):
#   gpt-4o            (OpenAI 综合最强)
#   gpt-4o-mini       (性价比首选)
#   o1-mini / o1      (OpenAI 推理模型)
#   deepseek-reasoner (DeepSeek-R1 高性价比推理)
#   deepseek-chat     (DeepSeek-V3)
#   claude-3-5-sonnet-20241022 (Anthropic, 通过 OpenRouter)
OPENAI_MODEL=gpt-4o-mini

# 是否启用 RAG (基于 FAQ + 平台数据自动检索增强)
ENABLE_RAG=true

# ============ QPred 官方 API ============
QPRED_API_BASE=https://api.qpred.io
QPRED_WEBSITE=https://www.qpred.io

# ============ 数据库 ============
DATABASE_PATH=./data/qpred_bot.db

# ============ 日志 ============
LOG_LEVEL=INFO
LOG_FILE=./logs/qpred_bot.log

# ============ 功能开关 ============
ENABLE_AI=true
ENABLE_GUARDIAN=true
ENABLE_CAPTCHA=true
CAPTCHA_TIMEOUT=60
ANTI_FLOOD_WINDOW=10
ANTI_FLOOD_MAX=5

# ============ 定时广播 ============
# 0 = 关闭, 单位: 分钟
BROADCAST_MARKETS_INTERVAL=120
BROADCAST_PRICE_INTERVAL=60
