# ============ Telegram 配置 ============
# 从 @BotFather 获取
BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 管理员 Telegram User ID (多个用逗号分隔)
# 获取方式: 给 @userinfobot 发消息
ADMIN_IDS=123456789,987654321

# 群组 ID (可选, 用于定向广播 / 定时播报)
GROUP_CHAT_ID=-1001234567890

# ============ AI 配置 (默认走 Tokenhot 统一网关) ============
# 所有模型路由 https://tokenhot.ai/zh -> https://api.tokenhot.ai/v1
AI_PROVIDER=tokenhot

# 在 https://api.tokenhot.ai/console/token 生成 Key, 形如 sk-xxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tokenhot Base URL (默认即可, 无需修改)
OPENAI_BASE_URL=https://api.tokenhot.ai/v1

# 主推理模型 (任选其一, Tokenhot 同一 Key 全部支持):
#   gpt-5.4-nano            性价比
#   claude-sonnet-4-6       核心首选 (推荐)
#   claude-opus-4-6         顶级
#   o3                      推理王者
#   deepseek-v3.2           国产强者
#   gemini-3-flash          快速响应
#   gpt-5.2-high            综合最强
OPENAI_MODEL=claude-sonnet-4-6

# 启用 RAG (FAQ 检索 + 平台实时数据注入)
ENABLE_RAG=true

# 群里是否每条消息都用 AI 回答? true=全员客服 / false=仅 @机器人/关键词触发
REPLY_ALL_GROUP_MESSAGES=true

# ============ QPred 官方 API ============
QPRED_API_BASE=https://api.qpred.io
QPRED_WEBSITE=https://www.qpred.io

# ============ 数据库 ============
DATABASE_PATH=./data/qpred_bot.db

# ============ 日志 ============
LOG_LEVEL=INFO
LOG_FILE=./logs/qpred_bot.log

# ============ 功能开关 ============
ENABLE_AI=true
ENABLE_GUARDIAN=true
ENABLE_CAPTCHA=true
CAPTCHA_TIMEOUT=60
ANTI_FLOOD_WINDOW=10
ANTI_FLOOD_MAX=5

# ============ 定时广播 ============
# 0 = 关闭, 单位: 分钟
BROADCAST_MARKETS_INTERVAL=120
BROADCAST_PRICE_INTERVAL=60
